[gd_scene format=3 uid="uid://shopitem00001"]

[ext_resource type="Script" path="res://UI/HUD/Shop/SpawnerShop/shop_item.gd" id="1_item"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.06, 0.06, 0.08, 0.55)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.22, 0.22, 0.28, 0.70)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="ShopItem" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")
script = ExtResource("1_item")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="Info" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 3

[node name="NameLabel" type="Label" parent="Margin/HBox/Info"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "COMPUTER"

[node name="PriceLabel" type="Label" parent="Margin/HBox/Info"]
layout_mode = 2
modulate = Color(0.55, 0.55, 0.65, 1.0)
theme_override_font_sizes/font_size = 9
text = "50 bits"

[node name="BuyBtn" type="Button" parent="Margin/HBox"]
layout_mode = 2
custom_minimum_size = Vector2(42, 24)
theme_override_font_sizes/font_size = 10
text = "BUY"

[connection signal="pressed" from="Margin/HBox/BuyBtn" to="." method="_on_buy_btn_pressed"]
